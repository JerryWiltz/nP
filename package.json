{
  "name": "np",
  "version": "0.0.47",
  "main": "./dist/nP.cjs",
  "module": "./dist/nP.esm.js",
  "browser": "./dist/nP.js",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/nP.esm.js",
      "require": "./dist/nP.cjs",
      "default": "./dist/nP.esm.js"
    },
    "./browser": "./dist/nP.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rollup -c",
    "test": "node --loader ./scripts/extensionless-loader.mjs --test",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:serve": "vitepress serve docs",
    "docs:preview": "vitepress preview docs",
    "deploy": "./scripts/deploy.sh",
    "clean": "bash scripts/cleanup-gitignore.sh",
    "dev:new": "node scripts/create-dev-html.mjs"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.1",
    "d3": "^7.9.0",
    "playwright": "^1.61.1",
    "rollup": "^4.61.1",
    "vitepress": "^1.6.4"
  },
  "overrides": {
    "vite": "6.4.3"
  },
  "description": "JavaScript RF and microwave n-port analysis with S-parameters, microstrip models, and SVG visualization",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JerryWiltz/nP.git"
  },
  "keywords": [
    "rf",
    "microwave",
    "s-parameters",
    "smith-chart",
    "n-port",
    "circuit-analysis"
  ],
  "author": "Jerry Wiltz",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/JerryWiltz/nP/issues"
  },
  "homepage": "https://github.com/JerryWiltz/nP#readme"
}
