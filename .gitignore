# ========================
# Node & build artifacts
# ========================

# Node dependencies (auto-installed via npm install)
node_modules/

# Rollup build output (generated by npm run build)
# dist/

# VitePress build output (generated by npm run docs:build)
docs/.vitepress/dist/

# ========================
# Logs & temporary files
# ========================

# Any log files (includes debug.log and others)
*.log

# ========================
# Drafts & private content
# ========================

# Ignore any draft/archived folders in docs that start with "_"
docs/_*/

# ========================
# Verification / test files
# ========================

# Ignore your test/verification HTML files (or any file ending with Verify.html)
nPortBuildVerify.html
nPortVersionVerify.html
*Verify.html

# ========================
# Misc
# ========================

# Ignore GitHub Pages .nojekyll marker if it shows up in root
.nojekyll
