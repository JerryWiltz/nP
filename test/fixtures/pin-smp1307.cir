set numdgt=15
set wr_singlescale
set wr_vecnames
op
wrdata /tmp/pin-dc.txt v(a0) v(a1) v(a2) v(a3) i(Voff)
ac lin 1 10000000.0 10000000.0
wrdata /tmp/pin-rf-0-p1.txt v(aRF0) v(kRF0)
alter @Ia0[acmag] = 0
alter @Ik0[acmag] = 1
ac lin 1 10000000.0 10000000.0
