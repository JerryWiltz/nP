njf external self-bias reference
* Modified: 2026-11-19
.temp 27
.options gmin=1e-18 abstol=1e-18 reltol=1e-10
.model device NJF (VTO=-3.86852 BETA=0.000307346 LAMBDA=0.00449867 RD=15.735 RS=49.9999 IS=1e-14 CGS=1e-12 CGD=1e-12 PB=1 FC=0.5 KF=1e-20 AF=0.2)
VDD supply 0 12
RD supply drain 2200
RG gate 0 1e6
RS source 0 2200
J1 drain gate source device
.control
set numdgt=16
set wr_vecnames
set wr_singlescale
op
wrdata njf-self-bias.txt v(gate) v(drain) v(source) i(VDD)
quit
.endc
.end
